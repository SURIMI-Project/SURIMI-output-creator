{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug app.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/app.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {},
            "stopOnEntry": false
        },
        {
            "name": "Pytest: integration tests (use running service)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["integration_tests/tests", "-v", "-s"],
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}